// Design: Moore FSM Sequence Detector for "101"
module fsm_101_detector (
    input  wire clk,
    input  wire rst_n,  // Active-low asynchronous reset
    input  wire in,     // Serial binary input
    output reg  out     // Output high when "101" is detected
);

    // State Encoding using parameters
    parameter IDLE = 2'b00,
              S1   = 2'b01,  // Detected '1'
              S10  = 2'b10,  // Detected '10'
              S101 = 2'b11;  // Detected '101'

    reg [1:0] current_state, next_state;

    // Block 1: Sequential state register
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) 
            current_state <= IDLE;
        else 
            current_state <= next_state;
    end

    // Block 2: Combinational next-state logic
    always @(*) begin
        case (current_state)
            IDLE: begin
                if (in) next_state = S1;
                else    next_state = IDLE;
            end
            
            S1: begin
                if (in) next_state = S1;
                else    next_state = S10;
            end
            
            S10: begin
                if (in) next_state = S101;
                else    next_state = IDLE;
            end
            
            S101: begin
                // Allowing overlapping sequences (the last '1' could be the first '1' of next sequence)
                if (in) next_state = S1;
                else    next_state = S10;
            end
            
            default: next_state = IDLE;
        endcase
    end

    // Block 3: Combinational output logic (Moore style - depends only on current state)
    always @(*) begin
        case (current_state)
            S101:    out = 1'b1;
            default: out = 1'b0;
        endcase
    end

endmodule


//Testbench 

`timescale 1ns / 1ps

module tb_fsm_101_detector;

    // Inputs to Design Under Test (DUT)
    reg clk;
    reg rst_n;
    reg in;

    // Outputs from DUT
    wire out;

    // Instantiate the Design Under Test (DUT)
    fsm_101_detector uut (
        .clk(clk),
        .rst_n(rst_n),
        .in(in),
        .out(out)
    );

    // Clock generation (100MHz clock -> Period = 10ns)
    always #5 clk = ~clk;

    initial begin
        // Initialize Inputs
        clk = 0;
        rst_n = 0;
        in = 0;

        // Apply Reset for 20ns
        #20;
        rst_n = 1; // Release reset
        
        // --- Test Scenario 1: Feeding valid "101" sequence ---
        @(posedge clk); in = 1; // Transitions to S1
        @(posedge clk); in = 0; // Transitions to S10
        @(posedge clk); in = 1; // Transitions to S101 -> 'out' should go high here!
        
        // --- Test Scenario 2: Overlapping "10101" sequence ---
        @(posedge clk); in = 0; // Transitions to S10
        @(posedge clk); in = 1; // Transitions to S101 -> 'out' should go high again!
        
        // --- Test Scenario 3: Broken sequence ("1001") ---
        @(posedge clk); in = 0; // Transitions to S10
        @(posedge clk); in = 0; // Invalid bit, should reset to IDLE
        @(posedge clk); in = 1; // Transitions to S1
        
        // Finish simulation
        #40;
        $display("Simulation Finished Successfully.");
        $finish;
    end

    // Monitor outputs in the console window
    initial begin
        $monitor("Time = %0t ns | Reset = %b | Input = %b | State = %b | Output = %b", 
                 $time, rst_n, in, uut.current_state, out);
    end

endmodule

